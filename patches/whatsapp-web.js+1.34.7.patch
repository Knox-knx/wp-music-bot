+                    data,
+                    mimetype: msg.mimetype,
+                    filename: msg.filename,
+                    filesize: msg.size,
+                };
+            } catch (e) {
+                if (e.status && e.status === 404) return undefined;
+                throw e;
+            }
+        }, this.id._serialized);
