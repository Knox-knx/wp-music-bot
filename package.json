{
  "name": "whatsapp-bot",
  "version": "1.0.0",
  "description": "Production-ready WhatsApp Music, Lyrics, Moderation & Advertisement Bot",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --test --experimental-test-module-mocks",
    "test:watch": "node --test --watch --experimental-test-module-mocks",
    "lint": "eslint .",
    "check": "node --check src/app.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "music",
    "lyrics",
    "moderation",
    "advertisement"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^13.0.0",
    "dotenv": "^16.4.7",
    "node-cron": "^4.0.0",
    "p-limit": "^6.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0",
    "yt-dlp-exec": "^1.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
