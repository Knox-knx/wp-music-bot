# ─────────────────────────────────────────────────────────────
# WhatsApp Bot — Environment Configuration
# Copy to .env and adjust. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# Command prefix used in chats
BOT_PREFIX=!

# ── Administrators ───────────────────────────────────────────
# Comma separated international numbers WITHOUT '+', no spaces.
# At least one owner is required in production mode.
OWNER_NUMBERS=919XXXXXXXXX
ADMIN_NUMBERS=

# ── Storage ──────────────────────────────────────────────────
DATABASE_PATH=./database/bot.sqlite
# WhatsApp session directory (LocalAuth). Keep it persistent.
# Deleting it forces a fresh QR login.
AUTH_DATA_PATH=.wwebjs_auth
LOCK_FILE=./.bot.lock
TMP_DIR=./tmp
CACHE_DIR=./cache
LOG_DIR=./logs
LOG_LEVEL=info
LOG_PRETTY=false

# ── Media tools ──────────────────────────────────────────────
# The bot requires `ffmpeg` on the server for audio conversion.
# `yt-dlp` is bundled with the yt-dlp-exec dependency (auto-installed).
# Debian/Ubuntu: sudo apt install ffmpeg
#
# ── Music / audio ────────────────────────────────────────────
# Maximum audio file size sent to WhatsApp (MB)
MAX_AUDIO_MB=16
# Maximum track duration accepted (seconds)
MAX_AUDIO_DURATION_SECONDS=600
# Timeout for a single download job (ms)
DOWNLOAD_TIMEOUT_MS=600000
# Maximum simultaneous download jobs
DOWNLOAD_CONCURRENCY=2
# Number of YouTube results considered per search
SEARCH_RESULTS=5

# ── Lyrics ───────────────────────────────────────────────────
LYRICS_API_URL=https://lrclib.net/api
LYRICS_TIMEOUT_MS=15000

# ── Anti-spam ────────────────────────────────────────────────
ANTISPAM_ENABLED=true
ANTISPAM_WINDOW_SECONDS=10
ANTISPAM_MAX_MESSAGES=6
# delete | warn | mute | kick
ANTISPAM_ACTION=delete
# Temporary mute duration used by the mute action (seconds)
ANTISPAM_MUTE_SECONDS=300

# ── Advertisements ───────────────────────────────────────────
ADVERTISEMENTS_ENABLED=true
# Accepts 2, 3, 4 or 5 advertisements per day
DEFAULT_ADS_PER_DAY=2
AD_MAX_MESSAGE_LENGTH=1000

# ── Short-lived media cache ──────────────────────────────────
CACHE_TTL_SECONDS=3600
CACHE_MAX_FILES=20

# ── Input guards ─────────────────────────────────────────────
MAX_COMMAND_LENGTH=512

# ── Health check (local HTTP) ────────────────────────────────
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000

# ── Browser (Puppeteer / Chrome) ─────────────────────────────
BROWSER_HEADLESS=true
# Optional: absolute path to a Chrome/Chromium binary
BROWSER_EXECUTABLE_PATH=
BROWSER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-accelerated-2d-canvas,--no-first-run,--no-zygote,--single-process,--disable-gpu

# ── Live voice-call streaming (!play) ────────────────────────
# When enabled, !play starts a real WhatsApp group voice call from the web
# client and streams the song live as the call's microphone. This requires
# the WhatsApp Web account to have web calling enabled (rolling out since
# July 2026). If a live call cannot be established, the bot automatically
# falls back to sending a normal audio message and never claims otherwise.
VOICE_CALL_ENABLED=true
# Max time to wait for the call to be created
VOICE_CALL_START_TIMEOUT_MS=30000
# Max time to wait for the call to reach an active/connected state
VOICE_CALL_CONNECT_TIMEOUT_MS=30000
# Hard cap on playback duration per !play
VOICE_CALL_MAX_DURATION_SECONDS=600
# Local HTTP endpoint that streams PCM into the browser (audio injection)
VOICE_CALL_STREAM_HOST=127.0.0.1
VOICE_CALL_STREAM_PORT=38980
# NOTE: when VOICE_CALL_ENABLED=true, these Chromium flags are added
# automatically: --use-fake-device-for-media-stream,
# --use-fake-ui-for-media-stream, --autoplay-policy=no-user-gesture-required,
# --unsafely-treat-insecure-origin-as-secure=http://<STREAM_HOST>:<STREAM_PORT>

# ── Reliability ──────────────────────────────────────────────
MAX_RECONNECT_ATTEMPTS=15