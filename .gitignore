# ── Dependencies ───────────────────────────────────────────────
# NOTE: package-lock.json is intentionally TRACKED (reproducible installs).
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# ── Environment / secrets ──────────────────────────────────────
# Never commit real credentials. .env.example stays tracked.
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
!.env.example

# ── WhatsApp session & browser cache ───────────────────────────
# Deleting these forces a fresh QR login — keep them persistent locally/in volumes.
.wwebjs_auth/
.wwebjs_cache/
.auth/
.cache/puppeteer/
.local-chromium/

# ── SQLite / persistence (local only) ──────────────────────────
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm
database/*.sqlite
database/*.sqlite-wal
database/*.sqlite-shm
database/*.sqlite-journal

# ── Runtime / generated folders ────────────────────────────────
logs/
tmp/
cache/
coverage/
.nyc_output/
dist/
build/
out/

# ── Single-instance lock & pid files ───────────────────────────
.bot.lock
*.pid
*.seed
*.lock

# ── Dev scratch / probe scripts (repo root) ────────────────────
probe*.mjs
probe*.js
audio-test*
verify-song*
*.tmp.mjs
*.tmp.js

# ── Logs & debug output ────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.out

# ── Temp / backup files ────────────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
~$*

# ── OS files ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editors / IDEs ─────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
.vim/
*.iml

# ── Docker ─────────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ── Patches (keep tracked — required by patch-package postinstall) ──
# patches/ is intentionally NOT ignored.
